---
import Base from "../../layouts/Base.astro";
import SkillCard from "../../components/SkillCard.astro";
import { getSkills, CATEGORY_LABEL, SOURCE_LABEL } from "../../lib/skills";

const skills = getSkills();

const categories = [...new Set(skills.map((s) => s.category).filter(Boolean))].sort() as string[];
const sources = [...new Set(skills.map((s) => s.source))].sort();
const tags = [...new Set(skills.flatMap((s) => s.tags))].sort();
---

<Base title="مهارت‌ها" description="کتابخانهٔ باز agent skill — فارسی، با فرمت استاندارد agentskills.io." path="/skill">
  <div class="wrap head">
    <h1>مهارت‌ها</h1>
    <p><span data-count>{skills.length}</span> مهارت · قابل نصب با <code>npx hmrbot skill add</code></p>
  </div>

  <div class="wrap layout" id="catalog">
    <aside class="filters">
      <div class="filters__row">
        <input type="search" data-search-input placeholder="جست‌وجو…" aria-label="جست‌وجو" />
        <button class="btn" data-clear>پاک کردن</button>
      </div>

      <label class="filters__sort">
        مرتب‌سازی
        <select data-sort>
          <option value="name">نام</option>
          <option value="category">دسته</option>
        </select>
      </label>

      {
        categories.length > 0 && (
          <fieldset>
            <legend>دسته</legend>
            {categories.map((c) => (
              <label class="opt">
                <input type="checkbox" data-filter="category" value={c} />
                <span>{CATEGORY_LABEL[c] ?? c}</span>
              </label>
            ))}
          </fieldset>
        )
      }

      {
        sources.length > 1 && (
          <fieldset>
            <legend>منبع</legend>
            {sources.map((s) => (
              <label class="opt">
                <input type="checkbox" data-filter="source" value={s} />
                <span>{SOURCE_LABEL[s] ?? s}</span>
              </label>
            ))}
          </fieldset>
        )
      }

      {
        tags.length > 0 && (
          <fieldset>
            <legend>برچسب</legend>
            <div class="tags">
              {tags.map((t) => (
                <label class="tag">
                  <input type="checkbox" data-filter="tag" value={t} />
                  <span>{t}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )
      }
    </aside>

    <div class="results">
      <div class="grid" data-grid>
        {skills.map((skill) => <SkillCard skill={skill} />)}
      </div>
      <p class="empty" data-empty hidden>هیچ مهارتی با این فیلترها پیدا نشد.</p>
    </div>
  </div>
</Base>

<script>
  import "../../scripts/filter.ts";
</script>

<style>
  .head {
    margin-bottom: var(--sp-8);
  }
  .head h1 {
    margin-bottom: var(--sp-2);
  }
  .head p {
    color: var(--muted);
    margin: 0;
  }

  .layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--sp-8);
    align-items: start;
  }

  .filters {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    font-size: var(--fs-sm);
  }
  .filters__row {
    display: flex;
    gap: var(--sp-2);
  }
  .filters input[type="search"] {
    flex: 1;
    min-width: 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
  }
  .filters__sort {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-2);
  }
  .filters__sort select {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    padding: var(--sp-1) var(--sp-2);
  }
  fieldset {
    border: none;
    border-top: 1px solid var(--border);
    padding: var(--sp-4) 0 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  legend {
    color: var(--muted);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0;
    margin-bottom: var(--sp-2);
  }
  .opt {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    cursor: pointer;
    color: var(--text-2);
  }
  .opt:hover {
    color: var(--text);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .tag {
    cursor: pointer;
  }
  .tag input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tag span {
    display: inline-block;
    padding: 2px var(--sp-2);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--text-2);
    direction: ltr;
  }
  .tag input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--sp-4);
  }
  .empty {
    padding: var(--sp-12) 0;
    text-align: center;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .filters {
      position: static;
    }
  }
</style>
