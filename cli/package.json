{
  "name": "hmrbot",
  "version": "0.1.0",
  "description": "Install agent skills from the hmrbot Hub (hub.hmrbot.com).",
  "type": "module",
  "bin": {
    "hmrbot": "./dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
