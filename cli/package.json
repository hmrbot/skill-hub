    "type": "git",
    "url": "https://github.com/hmrbot/skill-hub",
    "directory": "cli"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
